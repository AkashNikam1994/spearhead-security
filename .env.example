# ─── Site public URL (used for canonical URLs, sitemap, Open Graph) ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Enquiry email notifications (optional) ─────────────────────────────
# If RESEND_API_KEY is set, enquiry notifications are sent through the
# Resend HTTP API (no SDK required). Leave empty to disable.
RESEND_API_KEY=
ENQUIRY_NOTICE_EMAIL=

# ─── Database (optional, for production) ────────────────────────────────
# By default, enquiries and career applications are appended to JSON files
# under ./data (git-ignored). For production, provision PostgreSQL using
# the schema in server/db/schema.sql and a migration/integration of your
# choice. See README.md → "Storage".
DATABASE_URL=
